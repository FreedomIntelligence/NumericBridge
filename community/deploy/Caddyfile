{$NUMERICBRIDGE_COMMUNITY_HOST} {
	@search {
		method POST
		path /mcp
	}
	handle @search {
		request_body {
			max_size 65536
		}
		reverse_proxy 127.0.0.1:8786
	}

	handle /mcp {
		header Allow POST
		respond 405
	}

	@submission {
		method POST
		path /v1/submissions
	}

	handle @submission {
		request_body {
			max_size 327680
		}
		reverse_proxy 127.0.0.1:8770
	}

	@status {
		method GET
		path_regexp "^/v1/submissions/submission-[0-9a-f]{64}$"
	}
	handle @status {
		reverse_proxy 127.0.0.1:8770
	}

	@health {
		method GET HEAD
		path /healthz
	}
	handle @health {
		reverse_proxy 127.0.0.1:8770
	}

	handle {
		respond 404
	}
}
